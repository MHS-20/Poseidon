FROM golang:1.23-alpine AS builder
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /build/poseidon-worker ./cmd/worker

FROM alpine:3.19
RUN apk add --no-cache ca-certificates
COPY --from=builder /build/poseidon-worker /usr/local/bin/poseidon-worker
EXPOSE 5556
ENTRYPOINT ["poseidon-worker"]
