{
    "name": "poseidon-dns",
    "image": "poseidon-dns:latest",
    "restartPolicy": "always",
    "ports": [
        { "hostPort": 53, "containerPort": 53, "protocol": "udp" }
    ],
    "env": {
        "POSEIDON_RAFT_ADDR": "host.docker.internal:9001",
        "POSEIDON_DNS_ADDR": "0.0.0.0:53"
    },
    "cpus": 0.1,
    "memory": 67108864
}
